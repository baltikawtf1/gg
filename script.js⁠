let currentUnitPrice = 0;

// Открытие модального окна
function openModal(productName, price) {
  currentUnitPrice = price;
  
  const modal = document.getElementById('orderModal');
  const productText = document.getElementById('selectedProductText');
  const productInput = document.getElementById('productInput');
  const areaInput = document.getElementById('area');
  const totalPriceElement = document.getElementById('totalPrice');

  if (modal) {
    modal.style.display = 'flex';
    if (productText) productText.innerText = productName + ' (' + price + ' ₽/м²)';
    if (productInput) productInput.value = productName;
    if (areaInput) areaInput.value = '';
    if (totalPriceElement) totalPriceElement.innerText = '0 ₽';
  }
}

// Закрытие модального окна
function closeModal() {
  const modal = document.getElementById('orderModal');
  if (modal) {
    modal.style.display = 'none';
  }
}

// Расчет стоимости в реальном времени
function calculateTotal() {
  const area = document.getElementById('area').value;
  const totalPriceElement = document.getElementById('totalPrice');
  
  if (area && area > 0) {
    const total = area * currentUnitPrice;
    totalPriceElement.innerText = total.toLocaleString('ru-RU') + ' ₽';
  } else {
    totalPriceElement.innerText = '0 ₽';
  }
}

// Отправка формы
function submitForm(event) {
  event.preventDefault();

  const product = document.getElementById('productInput').value;
  const area = document.getElementById('area').value;
  const name = document.getElementById('name').value;
  const phone = document.getElementById('phone').value;
  const total = (area * currentUnitPrice).toLocaleString('ru-RU');

  alert(`Заявка успешно отправлена!\n\nИмя: ${name}\nТелефон: ${phone}\nВыбранный кирпич: ${product}\nПлощадь: ${area} м²\nРасчетная стоимость: ~${total} ₽\n\nМы свяжемся с вами в ближайшее время!`);

  closeModal();
  document.getElementById('orderForm').reset();
}

// Закрытие по клику вне окна
window.onclick = function(event) {
  const modal = document.getElementById('orderModal');
  if (event.target === modal) {
    closeModal();
  }
};
